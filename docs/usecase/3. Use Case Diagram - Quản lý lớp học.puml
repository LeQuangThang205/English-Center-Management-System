@startuml ClassAndAcademicActivities
' ============================================================
' Baseline v1.0 — 2026-07-20
' ============================================================
left to right direction

' Actors
actor Student as ST
actor Teacher as TC
actor Admin as AD

' System Boundary
rectangle "English Center Management System" {
  ' Use Cases
  usecase UC1 as "Quản lý lớp học"
  usecase UC2 as "Phân công giáo viên"
  usecase UC3 as "Điểm danh"
  usecase UC4 as "Quản lý điểm"
  usecase UC5 as "Xem lịch học"
  usecase UC6 as "Xem điểm số"
}

' Relationships
AD --> UC1
' Chỉ Admin mới có quyền phân công giáo viên
AD --> UC2
TC --> UC3
TC --> UC4
TC --> UC5
TC --> UC6
ST --> UC5
ST --> UC6
AD --> UC5
AD --> UC6

@enduml
