@startuml Authentication
' ============================================================
' Baseline v1.0 — 2026-07-20
' ============================================================
left to right direction

' Actors
actor Guest as GU
actor Student as ST
actor Teacher as TC
actor Admin as AD

' System Boundary
rectangle "English Center Management System" {
  ' Use Cases
  usecase UC1 as "Đăng ký tài khoản"
  usecase UC2 as "Đăng nhập"
  usecase UC3 as "Đăng xuất"
  usecase UC4 as "Quên mật khẩu"
  usecase UC5 as "Đổi mật khẩu"
  usecase UC6 as "Xem thông tin cá nhân"
}

' Relationships
GU --> UC1
GU --> UC2
GU --> UC4
ST --> UC2
ST --> UC3
ST --> UC5
ST --> UC6
TC --> UC2
TC --> UC3
TC --> UC5
TC --> UC6
AD --> UC2
AD --> UC3
AD --> UC5
AD --> UC6

@enduml
