@startuml AIFeatures
' ============================================================
' Baseline v1.0 — 2026-07-20
' ============================================================
left to right direction

' Actors
actor Guest as GU
actor Student as ST
actor Admin as AD
actor "AI Service" as AI

' System Boundary
rectangle "English Center Management System" {
  ' Use Cases
  usecase UC1 as "Trò chuyện với AI"
  usecase UC2 as "Nhận gợi ý khóa học"
  usecase UC3 as "Sử dụng trợ lý AI"
  usecase UC4 as "Quản lý kho FAQ"
}

' Relationships
GU --> UC1
ST --> UC1
ST --> UC2
AD --> UC3
AD --> UC4

' Các UC này gọi AI Service (secondary actor) trực tiếp, không qua include
UC1 --> AI
UC2 --> AI
UC3 --> AI

@enduml
